{
  "name": "@codeatlas/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "CodeAtlas MCP Server — expose the code graph to AI tools via the Model Context Protocol",
  "license": "MIT",
  "keywords": [
    "code-analysis",
    "knowledge-graph",
    "mcp",
    "model-context-protocol",
    "ai"
  ],
  "homepage": "https://github.com/Fenghu146/CodeAtlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fenghu146/CodeAtlas.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/Fenghu146/CodeAtlas/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/server.js",
  "bin": {
    "codeatlas-mcp": "dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@codeatlas/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
