{
  "name": "@codeatlas/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "CodeAtlas CLI — command-line interface for the code knowledge graph",
  "license": "MIT",
  "keywords": [
    "code-analysis",
    "knowledge-graph",
    "cli",
    "tree-sitter"
  ],
  "homepage": "https://github.com/Fenghu146/CodeAtlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fenghu146/CodeAtlas.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Fenghu146/CodeAtlas/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/index.js",
  "bin": {
    "codeatlas": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@codeatlas/core": "workspace:*",
    "commander": "^15.0.0",
    "chalk": "^5.4.0",
    "ora": "^8.1.0",
    "cli-table3": "^0.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
